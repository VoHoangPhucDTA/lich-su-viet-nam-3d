APP_FRONTEND_BASE_URL=http://localhost:5173
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/lichsuvn?useSSL=false&connectionTimeZone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-your-local-db-password

APP_MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
# For Gmail app passwords, paste the 16-character value without spaces.
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true

APP_AUTH_GOOGLE_CLIENT_ID=

# Internal FastAPI AI Service (Gemini credentials stay in ai-service only)
AI_SERVICE_ENABLED=true
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_CONNECT_TIMEOUT=5s
AI_SERVICE_READ_TIMEOUT=90s
AI_SERVICE_GENERATION_PATH=/ai/quiz/generate
AI_SERVICE_HEALTH_PATH=/ai/health
AI_SERVICE_MAX_STYLE_EXAMPLES=3

# Facebook OAuth (P2) - get from Meta Developer Console > App Dashboard
APP_AUTH_FACEBOOK_APP_ID=
APP_AUTH_FACEBOOK_APP_SECRET=
# Optional: default is v21.0
# APP_AUTH_FACEBOOK_GRAPH_VERSION=v21.0

# Cloudinary (avatar management)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: existing/default avatar public URL (leave blank to auto-generate)
CLOUDINARY_DEFAULT_AVATAR=

# Managed Admin event images. Keep upload disabled until V42 and storage smoke checks pass.
APP_EVENT_IMAGE_UPLOAD_ENABLED=false
APP_EVENT_IMAGE_CLEANUP_ENABLED=false
APP_EVENT_IMAGE_UPLOAD_TIMEOUT_MS=30000
APP_EVENT_IMAGE_UPLOAD_RESERVATION_MINUTES=10
APP_EVENT_IMAGE_CLEANUP_INTERVAL_MS=60000
APP_EVENT_IMAGE_CLEANUP_LEASE_SECONDS=120
APP_EVENT_IMAGE_CLEANUP_MAX_ATTEMPTS=5

# TTS audio cache and long-narration assembly
APP_TTS_CLOUDINARY_ROOT_FOLDER=history_audio
APP_TTS_CLOUDINARY_NARRATIONS_FOLDER=narrations
APP_TTS_CLOUDINARY_CHUNKS_FOLDER=chunks
APP_TTS_CHUNK_TARGET_LENGTH=1800
APP_TTS_CHUNK_HARD_MAX_LENGTH=2000
# Set these to the executable paths in the deployment image/host.
APP_TTS_FFMPEG_EXECUTABLE=ffmpeg
APP_TTS_FFPROBE_EXECUTABLE=ffprobe
