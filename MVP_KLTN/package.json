{
  "name": "mvp-kltn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "audit:locations": "node scripts/audit-event-locations.mjs",
    "suggest:locations": "node scripts/suggest-event-locations.mjs",
    "apply:locations": "node scripts/apply-location-suggestions.mjs",
    "build:exams-manifest": "node scripts/build-exams-manifest.mjs",
    "build:topic-index": "node scripts/build-topic-index.mjs",
    "build:data": "npm run build:exams-manifest && npm run build:topic-index",
    "predev": "npm run build:data",
    "prebuild": "npm run build:data",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "cesium": "^1.139.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "resium": "^1.19.4",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.1.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0",
    "vitest": "^4.1.7"
  }
