@startuml usecase_diagram_dethi
!pragma layout smetana
title " "
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FEFCE8
  BorderColor #A16207
}
skinparam actorStyle awesome

actor "Học sinh\n(đã đăng nhập)" as HS

note as N1
  Khách (chưa đăng nhập) cũng có thể
  duyệt danh sách đề thi công khai.
end note

rectangle "Phân hệ Ôn luyện & Thi thử" {
  usecase "Duyệt danh sách đề thi\n(theo lớp, chủ đề)" as UC1
  usecase "Tạo đề tùy chọn\n(số câu, độ khó, thời gian)" as UC2
  usecase "Làm đề thi thử\n(chế độ tính giờ)" as UC3
  usecase "Đồng hồ đếm ngược &\nsidebar theo dõi tiến độ" as UC3a
  usecase "Luyện tập tự do\n(không tính giờ)" as UC4
  usecase "Ôn tập theo chủ đề" as UC5
  usecase "Ôn lại câu sai" as UC6
  usecase "Nộp bài & chấm điểm" as UC7
  usecase "Xem kết quả chi tiết\n(đáp án, giải thích)" as UC8
  usecase "Xem lịch sử làm bài" as UC9
  usecase "Xem thống kê học tập\n(dashboard tổng quan)" as UC10
}

' include / extend
UC3 ..> UC1 : <<include>>
UC3 ..> UC3a : <<include>>
UC3 ..> UC7 : <<include>>
UC4 ..> UC7 : <<include>>
UC5 ..> UC7 : <<include>>
UC6 ..> UC9 : <<extend>>
UC8 ..> UC7 : <<extend>>
UC2 ..> UC3 : <<extend>>

' actor
HS --> UC1
HS --> UC2
HS --> UC3
HS --> UC4
HS --> UC5
HS --> UC6
HS --> UC8
HS --> UC9
HS --> UC10
caption Sơ đồ Use Case chi tiết - Ôn luyện & Thi thử THPT
@enduml
