@startuml usecase_auth_6c
skinparam maxMessageSize 150
actor "Người dùng" as U
participant "ForgotPasswordPage.tsx\nResetPasswordPage.tsx" as UI
participant "authService.ts" as SRV_TS
participant "AuthController.java" as CTR
participant "AuthService.java" as SRV
database "MySQL" as DB
participant "Hệ thống Email" as SMTP

group Normal Flow: Yêu cầu đặt lại và Cập nhật mật khẩu (6C.1)
    U -> UI : 6C.1.1: ForgotPasswordPage.tsx:\nNhập email và nhấn nút Gửi.
    activate UI
    UI -> SRV_TS : 6C.1.2: ForgotPasswordPage.tsx:\ngọi hàm forgotPassword trong authService.ts.
    deactivate UI
    activate SRV_TS
    SRV_TS -> CTR : 6C.1.3: authService.ts:\ngọi POST /api/auth/forgot-password đến AuthController.java.
    activate CTR
    CTR -> SRV : 6C.1.4: AuthController.java:\ngọi AuthService.java (hàm requestPasswordReset).
    activate SRV
    SRV -> DB : 6C.1.5: AuthService.java:\nkiểm tra sự tồn tại của email trong MySQL.
    activate DB
    DB --> SRV : 6C.1.6: MySQL:\ntrả về User Entity hợp lệ.
    deactivate DB
    SRV -> SMTP : 6C.1.7: AuthService.java:\ntạo token và gửi email reset qua SMTP.
    activate SMTP
    SMTP --> SRV : (Email sent)
    deactivate SMTP
    SRV --> CTR : 6C.1.8: AuthService.java:\ntrả kết quả thành công cho AuthController.java.
    deactivate SRV
    CTR --> SRV_TS : 6C.1.9: AuthController.java:\ntrả HTTP 200 cho authService.ts.
    deactivate CTR
    SRV_TS --> UI : 6C.1.10: authService.ts:\ntrả dữ liệu cho ForgotPasswordPage.tsx.
    deactivate SRV_TS
    activate UI
    UI -> UI : 6C.1.11: ForgotPasswordPage.tsx:\nhiển thị thông báo "Vui lòng kiểm tra hộp thư của bạn" kèm email.
    deactivate UI
    
    U -> UI : 6C.1.12: ResetPasswordPage.tsx:\nNgười dùng nhấp vào link từ email, nhập mật khẩu mới và nhấn nút Đặt lại.
    activate UI
    UI -> SRV_TS : 6C.1.13: ResetPasswordPage.tsx:\ngọi hàm resetPassword trong authService.ts.
    deactivate UI
    activate SRV_TS
    SRV_TS -> CTR : 6C.1.14: authService.ts:\ngọi POST /api/auth/reset-password đến AuthController.java.
    activate CTR
    CTR -> SRV : 6C.1.15: AuthController.java:\ngọi AuthService.java (hàm resetPassword).
    activate SRV
    SRV -> DB : 6C.1.16: AuthService.java:\nxác thực token an toàn và mã hoá mật khẩu mới lưu vào MySQL.
    activate DB
    DB --> SRV : 6C.1.17: MySQL:\nxác nhận cập nhật thành công và xóa token.
    deactivate DB
    SRV --> CTR : 6C.1.18: AuthService.java:\ntrả kết quả cho AuthController.java.
    deactivate SRV
    CTR --> SRV_TS : 6C.1.19: AuthController.java:\ntrả HTTP 200 cho authService.ts.
    deactivate CTR
    SRV_TS --> UI : 6C.1.20: authService.ts:\ntrả dữ liệu thành công cho ResetPasswordPage.tsx.
    deactivate SRV_TS
    activate UI
    UI -> UI : 6C.1.21: ResetPasswordPage.tsx:\nhiển thị thông báo thành công và chuyển hướng người dùng về trang Đăng nhập.
    deactivate UI
end
@enduml
