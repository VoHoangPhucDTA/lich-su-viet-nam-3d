  "summary": {
    "homepageTitle": "Hội nghị Diên Hồng (1285)",
    "homepageSummary": "Hội nghị do Thượng hoàng Trần Thánh Tông tổ chức tại kinh thành Thăng Long, hỏi kế sách đánh giặc Nguyên, thể hiện ý chí đồng lòng \"Đánh!\".",
    "cardSummary": "Hội nghị Diên Hồng năm 1285, các bô lão đồng thanh hô \"Đánh!\" khi được hỏi kế sách chống quân Nguyên."
  },
  "textbookContent": {
    "canonicalSummary": "Năm 1285, tại điện Diên Hồng ở kinh thành Thăng Long, khi Thượng hoàng Trần Thánh Tông hỏi về kế sách đánh giặc, các vị bô lão đều đồng thanh hô lớn: \"Đánh!\".",
    "detailedNarrative": null,
    "significance": "Thể hiện tinh thần đoàn kết, ý chí quyết tâm chống giặc ngoại xâm của toàn dân tộc, từ triều đình đến nhân dân.",
    "keyFacts": [
      "Diễn ra năm 1285",
