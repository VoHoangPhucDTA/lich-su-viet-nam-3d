{
  "name": "mvp-kltn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:encoding": "node scripts/check-source-encoding.mjs",
    "build": "npm run check:encoding && tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e:admin": "playwright test --config playwright.config.ts",
    "test:d10d": "node scripts/d10d-chronology-tests.mjs",
    "build:exams-manifest": "node scripts/build-exams-manifest.mjs",
    "build:topic-index": "node scripts/build-topic-index.mjs",
    "build:exam-dataset": "node scripts/build-exam-dataset.mjs",
    "build:data": "npm run build:exams-manifest && npm run build:topic-index && npm run build:exam-dataset",
    "test:exam-data": "node --test scripts/__tests__/exam-dataset-build.node-test.mjs",
    "predev": "npm run build:data",
    "prebuild": "npm run build:data",
    "preview": "vite preview",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "cesium": "^1.139.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.9.2",
    "resium": "^1.19.4",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "canonicalize": "3.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "json-dup-key-validator": "1.0.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0",
    "vitest": "^4.1.10"
  }
}
