# All VITE_* values are public and embedded in browser assets at build time.
# Never put OAuth client secrets, private API keys, or credentials here.
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# Public browser token. Restrict allowed domains and quota; never use a master token.
VITE_CESIUM_ION_TOKEN=

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Opt in only after the backend asset worker and Cloudinary delivery are deployed.
VITE_TTS_ASSET_PLAYER_ENABLED=false
